# ==============================================================================
# КОМА / TimPlan — Environment Configuration (.env)
# ==============================================================================

# ── Google Gemini API (Required for AI question & structure generation) ───────
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# ── Application Settings ──────────────────────────────────────────────────────
STORAGE_SECRET=timplan-secret-key-change-me-for-production
NICEGUI_RELOAD=true

# ── VPN Configuration (Gluetun / AmneziaWG) ──────────────────────────────────
# Required to route outbound Gemini API calls through VPN
VPN_ADDRESS=10.8.1.27/32
VPN_PRIVATE_KEY=your_amneziawg_private_key_here
VPN_PUBLIC_KEY=your_amneziawg_server_public_key_here
VPN_PRESHARED_KEY=your_amneziawg_preshared_key_here
VPN_ENDPOINT_IP=your_vpn_server_ip
VPN_ENDPOINT_PORT=37386

# AmneziaWG Obfuscation Parameters (AWG headers / junk packets)
VPN_JC=3
VPN_JMIN=10
VPN_JMAX=50
VPN_S1=105
VPN_S2=51
VPN_H1=1604721105
VPN_H2=23473415
VPN_H3=868556505
VPN_H4=1815630424

# Keepalive and MTU tuning
VPN_PERSISTENT_KEEPALIVE=25s
VPN_MTU=1200
